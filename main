import typer
from rich.console import Console
from rich.panel import Panel

from vigilant_waffle.core import monitor, waffle_mode

app = typer.Typer(help="Vigilant Waffle - Monitoring with personality")
console = Console()

@app.command()
def monitor(config: str = "config.yaml"):
    """Start the vigilant monitoring system"""
    console.print(Panel.fit("[bold yellow]Starting Vigilant Waffle Monitor[/bold yellow]"))
    monitor.start(config)

@app.command()
def waffle():
    """Activate maximum waffle mode"""
    console.print("[bold magenta]🧇 Waffle Mode Activated! 🧇[/bold magenta]")
    waffle_mode.activate()

@app.command()
def version():
    """Show version"""
    from vigilant_waffle import __version__
    console.print(f"[bold]vigilant-waffle[/bold] v{__version__}")

if __name__ == "__main__":
    app()
